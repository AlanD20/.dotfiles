{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bg-dark": "#242424",
    "bg-light": "#575656",
    "bg-lightdark": "#202020",
    "bg-primary": "#6272a4",
    "bg-secondary": "#516BEB",
    "blue": "#3A86FF",
    "danger": "#f1184c",
    "git-ahead": "#C792EA",
    "git-behind": "#C792EA",
    "git-changed": "p:warning",
    "git-diverged": "#c5e478",
    "git-unchanged": "p:success",
    "os": "p:blue",
    "success": "#33DD2D",
    "text-dark": "#000000",
    "text-light": "#ffffff",
    "text-lightdark": "#ACB0BE",
    "warning": "#FFBB00"
  },
  "debug_prompt": {
    "template": "Debugging ",
    "foreground": "#ffffff",
    "background": "transparent"
  },
  "secondary_prompt": {
    "template": "-> ",
    "foreground": "#ffffff",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "\uf07b  {{ .PWD }}{{ if ne .Code 0 }} <p:danger>[prev exit {{ .Code }}]</>{{ end }} \uf061 ",
    "foreground": "#ffffff",
    "background": "transparent"
  },
  "console_title_template": "{{.UserName}}@{{.HostName}} {{.Shell}} in {{.PWD}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          },
          "leading_diamond": "\ue0b6",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}}<#262626> \ue0b2</>",
          "foreground": "p:os",
          "background": "p:bg-dark",
          "type": "os",
          "style": "diamond",
          "min_width": 100
        },
        {
          "template": "<parentBackground>\ue0b0</> \uf292 ",
          "foreground": "p:text-dark",
          "powerline_symbol": "\ue0b0",
          "background": "p:danger",
          "type": "root",
          "style": "powerline"
        },
        {
          "template": " {{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} ",
          "foreground": "p:text-light",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-secondary",
          "type": "session",
          "style": "powerline"
        },
        {
          "options": {
            "folder_icon": " \uf07b ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\ue617",
            "style": "full"
          },
          "template": " {{ .Path }} ",
          "foreground": "p:text-light",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-primary",
          "type": "path",
          "style": "powerline",
          "min_width": 100
        },
        {
          "options": {
            "folder_icon": " \uf07b ",
            "folder_separator_icon": " \uf061 ",
            "home_icon": "\ue617",
            "style": "folder"
          },
          "template": " {{ .Path }} ",
          "foreground": "p:text-light",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-primary",
          "type": "path",
          "style": "powerline",
          "max_width": 99
        },
        {
          "options": {
            "azure_devops_icon": "\uebe8  ",
            "bitbucket_icon": "\uf171  ",
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_bare_info": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "git_icon": "\ue5fb ",
            "github_icon": "\uf408  ",
            "gitlab_icon": "\uf296  ",
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<p:danger> \uf046  {{ .Staging.String }}</>{{ end }} ",
          "foreground": "p:git-unchanged",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "git",
          "style": "powerline",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-changed{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-diverged{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git-behind{{ end }}"
          ]
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "always_enabled": true,
            "style": "roundrock",
            "threshold": 0
          },
          "template": " \ueba2 {{ .FormattedMs }}\u2800",
          "foreground": "p:text-light",
          "powerline_symbol": "\ue0b2",
          "background": "p:bg-light",
          "type": "executiontime",
          "style": "powerline",
          "invert_powerline": true,
          "min_width": 100
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \ue61e \ue61d cmake {{ .Full }} ",
          "foreground": "#E8EAEE",
          "powerline_symbol": "\ue0b0",
          "background": "#1E9748",
          "type": "cmake",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s",
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a>\ue5fa</> ",
            "yarn_icon": " <#348cba>\ue6a7</>"
          },
          "template": " \ue718{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ if .Mismatch }} <p:warning>\uf071 expected {{ .Expected }}</>{{ end }}{{ end }} ",
          "foreground": "p:success",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "node",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": "\udb80\udf1f {{ .Full }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "p:blue",
          "type": "php",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "foreground": "#FFE873",
          "powerline_symbol": "\ue0b0",
          "background": "#306998",
          "type": "python",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#ec2729",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "java",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \ue77f  {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#0d6da8",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "dotnet",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \udb81\udfd3  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#06aad5",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "go",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \ue64c {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#055b9c",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "dart",
          "style": "powerline",
          "min_width": 120
        },
        {
          "options": {
            "cache_duration": "5s"
          },
          "template": " \udb84\udd05 {{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "nx",
          "style": "powerline",
          "min_width": 120
        },
        {
          "template": " \udb83\ude0f {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "#faa029",
          "powerline_symbol": "\ue0b0",
          "background": "p:bg-dark",
          "type": "aws",
          "style": "powerline"
        },
        {
          "template": " \udb84\udcfe {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#316ce4",
          "type": "kubectl",
          "style": "powerline"
        },
        {
          "template": " \uf308  {{ .Context }} ",
          "foreground": "p:bg-dark",
          "powerline_symbol": "\ue0b0",
          "background": "#0B59E7",
          "type": "docker",
          "style": "powerline"
        },
        {
          "trailing_diamond": "\ue0b4",
          "template": " \ueb29 ",
          "foreground": "p:warning",
          "background": "p:bg-dark",
          "type": "text",
          "style": "diamond",
          "min_width": 120
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u2570\u2500",
          "foreground": "#21c7c7",
          "type": "text",
          "style": "plain"
        },
        {
          "trailing_diamond": "\ue0b4",
          "template": " exit {{ .Code }} ",
          "foreground": "#ffffff",
          "background": "p:danger",
          "type": "status",
          "style": "diamond",
          "invert_powerline": true
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:warning",
          "template": "{{ if gt .Jobs 0 }} [jobs {{ .Jobs }}] {{ end }}"
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": "\ue285\ueb9e ",
          "foreground": "#e0f8ff",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 4,
  "final_space": true
}
