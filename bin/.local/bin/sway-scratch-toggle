#!/usr/bin/python3
"""Toggle a scratchpad app, launching it when absent.

Usage: sway-scratch-toggle 'resize set 1080 768' 'app_id,scratch-term' \
    alacritty --class scratch-term
Selectors separated by pipes match alternatives, e.g.
'app_id,org.kde.dolphin|class,dolphin' for Wayland and X11 Dolphin.
"""

import json
import subprocess
import sys
import time


def sway(*args):
    result = subprocess.run(
        ["swaymsg", "-r", *args], check=True, capture_output=True, text=True
    )
    reply = json.loads(result.stdout)
    if isinstance(reply, list) and any(item.get("success") is False for item in reply):
        raise RuntimeError(f"Sway command failed: {reply}")
    return reply


def find_window(node, selectors):
    for field, value in selectors:
        actual = (
            node.get("window_properties", {}).get("class")
            if field == "class"
            else node.get("app_id")
        )
        if actual == value:
            return node["id"]
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = find_window(child, selectors)
        if found is not None:
            return found
    return None


def main():
    if len(sys.argv) < 4:
        raise ValueError(__doc__)
    commands, selector, *app = sys.argv[1:]
    selectors = [item.split(",", 1) for item in selector.split("|")]
    if any(
        len(item) != 2 or item[0] not in {"app_id", "class"} or not item[1]
        for item in selectors
    ):
        raise ValueError("Selectors must be app_id,value or class,value")

    window_id = find_window(sway("-t", "get_tree"), selectors)
    if window_id is not None:
        sway(f"[con_id={window_id}] scratchpad show")
        return

    # Query the tree after launching instead of relying on PID ownership or
    # a window event that may arrive before a subscription is established.
    subprocess.Popen(
        app,
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        window_id = find_window(sway("-t", "get_tree"), selectors)
        if window_id is not None:
            target = f"[con_id={window_id}]"
            sway(f"{target} floating enable")
            if commands:
                sway(f"{target} {commands}")
            sway(f"{target} move scratchpad")
            sway(f"{target} scratchpad show")
            return
        time.sleep(0.1)
    raise RuntimeError(f"No window matching {selector!r} appeared within 10 seconds")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"sway-scratch-toggle: {error}", file=sys.stderr)
        sys.exit(1)
